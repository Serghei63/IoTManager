                    "channel (номер канала графиков, 0..7)",
                    "value (числовое значение точки)"
                ]
            },
            {
                "name": "drawHistoryToChannel",
                "descr": "Выгрузка истории из RingBuffer в указанный канал дисплея DWIN",
                "params": [
                    "srcChannel (номер источника/буфера в RingBuffer)",
                    "dstChannel (номер канала на дисплее DWIN)"
                ]
            },
            {
                "name": "setTrendVisible",
                "descr": "Включение или отключение отображения канала графика на странице",
                "params": [
                    "page (номер страницы)",
                    "channel (номер канала, 0..7)",
                    "visible (1 - включить, 0 - выключить)"
                ]
            }
        ]
