                    "format (0-as is, 1-pad spaces, 2-pad zeros)",
                    "decimals (0..3)"
                ]
            },
            {
                "name": "updateSplitValue",
                "descr": "Вывод числа с разделением шрифтов (целая часть — крупно, дробная и единицы — мелко). Автоматически центрируется по ширине W.",
                "params": [
                    "text (значение, напр. '23.4 C' или '45 %')",
                    "x",
                    "y",
                    "w (ширина прямоугольника зачистки)",
                    "h (высота прямоугольника зачистки)",
                    "fontMain (шрифт целой части 1..5)",
                    "fontSub (шрифт дробной части 1..5)",
                    "decimals (знаков после запятой, 0 - без дробной части)"
                ]
            },
            {
                "name": "showImage",
                "descr": "Отобразить 1-bit BMP файл из LittleFS с опциональной зачисткой области",
                "params": [
                    "path (путь к файлу, напр. /bg.bmp)", 
                    "x", 
                    "y",
                    "w (ширина очистки, по умолчанию размер BMP)",
                    "h (высота очистки, по умолчанию размер BMP)"
                ]
            }
        ]
