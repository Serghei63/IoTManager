       arc1 = arc;
         arc = arc + 1;

      if (_id2show != _id) {
        IoTItem* trackingItem = findIoTItem(_id2show);
        if (trackingItem != nullptr) {
            _trackingValue = &(trackingItem->value);
         arc_id2[arc1] = ""; 
        }
    }
}

String valrt = "";
void drawItem(IoTItem *item) {

            lv_arc_set_value( ui_Arc[arc1], value.valD * 10);


            if (_id2show != _id && valrt != String(value.valD) && (_valueSource == "web" || _valueSource == "mqtt")){
                _generateOrderForTracking = true;
                _lastOrderTime = millis();
                if ( findIoTItem(_id2show) == nullptr)  {
                    otpravkaidvalue( _id2show, String(value.valD)); 
                    valrt = String(value.valD);    
                }
                else { generateOrder( _id2show, String(value.valD)); 
                    valrt = String(value.valD); 
                }
            }
    }

  void setValue(const IoTValue& Value, bool genEvent = true) {
        value = Value;

        bool directOrder = isCurrentOrderForMe();
        if (_pendingMqttUpdate) {
            _valueSource = "mqtt";
            _pendingMqttUpdate = false;
        } else if (directOrder) {
            _valueSource = "web";
        }

        drawItem(this);
        regEvent((String)(float)value.valD, F("Panel_arc"), false, genEvent);
    }

    String getValue() {
        return (String)(float)value.valD;
    }


    int j = 0;
    void onRegEvent(IoTItem* item) override {
        if ((_trackingValue == nullptr) && (item != nullptr) && (item->getID() == _id2show) && ( j < 2)) {
            _trackingValue = &(item->value);
            j = j + 1;
            arc_id2[arc1] = "";
        }
        if (item && item->getID() == _id2show && !_generateOrderForTracking) {
            if (_valueSource != "web" && _valueSource != "mqtt") {
                _valueSource = "id2show";
            }
            Serial.printf("[onRegEvent] %s registered event, source: %s\n", item->getID().c_str(), _valueSource.c_str());
        }
        IoTItem::onRegEvent(item);
    }

    void onTrackingValue(IoTItem* item) override {
        if (item == nullptr || _id == _id2show) return;

        bool isOwnOrder = _generateOrderForTracking && (millis() - _lastOrderTime < 50);
        if (isOwnOrder) {
            Serial.printf("[%s] onTrackingValue: own order from %s\n", _valueSource.c_str(), item->getID().c_str());
        } else {
            if ((millis() - _lastExternalUpdateTime < 100) && _lastExternalUpdateSource != "") {
                _valueSource = _lastExternalUpdateSource;
                Serial.printf("[%s] onTrackingValue: external update from %s\n", _valueSource.c_str(), item->getID().c_str());
            } else {
                _valueSource = "id2show";
                Serial.printf("[id2show] onTrackingValue: external update from %s\n", item->getID().c_str());
            }
        }
        _generateOrderForTracking = false;
        _pendingMqttUpdate = false;
        _lastExternalUpdateSource = "";
        IoTItem::onTrackingValue(item); // updates own value from tracked item
    }

    void onModuleOrder(String& key, String& value) override {
        if (key == _id || key == _id2show) {
            _valueSource = "web";
            _pendingMqttUpdate = false;
            if (key == _id2show && !_generateOrderForTracking) {
                _lastExternalUpdateTime = millis();
                _lastExternalUpdateSource = "web";
            }
            Serial.printf("[web] ModuleOrder: %s = %s\n", key.c_str(), value.c_str());
        }
        IoTItem::onModuleOrder(key, value);
    }

    bool isCurrentOrderForMe() {
        if (orderBuf.length() == 0) return false;
        String currentOrder = selectToMarker(orderBuf, ",");
        if (currentOrder.length() == 0) return false;
        String currentKey = selectToMarker(currentOrder, " ");
        return currentKey == _id;
    }

    IoTValue execute(String command, std::vector<IoTValue> &param){

            if (command == "hide"){
                lv_obj_add_flag(ui_Arc[arc - 1], LV_OBJ_FLAG_HIDDEN);
            };
           
            if (command == "show"){
                 lv_obj_clear_flag(ui_Arc[arc - 1], LV_OBJ_FLAG_HIDDEN);
            };

             if (command == "color"){
             color = param[0].valD;
             lv_obj_set_style_arc_color(ui_Arc[arc - 1], lv_color_hex(color), LV_PART_INDICATOR | LV_STATE_DEFAULT);
            }
            if (command == "pos"){
                _x = param[0].valD;
                _y = param[1].valD;
                lv_obj_set_pos(ui_Arc[arc - 1], _x, _y);
    
            }
        return {};

     };



    void onMqttRecive(String& topic, String& msg) override {
        _pendingMqttUpdate = true;
        IoTItem::onMqttRecive(topic, msg);
    }

 ~Panel_arc(){};
};


// обработка дуги с экрана
void ui_event_Arc(lv_event_t * e)
{
   int i = (int)lv_event_get_user_data(e);
  
    lv_event_code_t event_code = lv_event_get_code(e);

    
    if(event_code == LV_EVENT_VALUE_CHANGED) {
   
      valrt = lv_arc_get_value(ui_Arc[i]);   
    }
    if (event_code == LV_EVENT_RELEASED){ 

    String _valrt = String(valrt / 10);
        generateOrder( arc_id[i], String(valrt / 10));
    }    
    

}

