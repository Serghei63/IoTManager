//кнопка

class Panel_button : public IoTItem {
private:

    int _x = 0, _y = 0,  _x1 = 20, _y1 = 20, color_on = 87668, color_of = 36556;
    int nomer = 1;
    String  name = "";
    int color_border = 35435, size_border = 5, Visibility = 255;
    String _id2show = "";
    String _valueSource = "unknown";
    bool _pendingMqttUpdate = false;
    bool _generateOrderForTracking = false;
    unsigned long _lastOrderTime = 0;
    unsigned long _lastExternalUpdateTime = 0;
    String _lastExternalUpdateSource = "";
    int dig = 0, radius = 5;
    int isf11 = 0;

public:
    Panel_button(String parameters) : IoTItem(parameters) {

        
        jsonRead(parameters, "NAME", name);
        jsonRead(parameters, "Nomer", nomer);

        if (name == "TabPage" && tab2 >= nomer){
                ui_Button.push_back( lv_button_create( ui_TabPage[nomer - 1]));    
        }
        else if (name == "Button" && isf1 >= nomer ) {
             
                ui_Button.push_back( lv_button_create( ui_Button[nomer - 1]));}

        else if (name == "Container" && cont >= nomer ) {
             
                ui_Button.push_back( lv_button_create( ui_Container[nomer - 1]));}

        else {ui_Button.push_back( lv_button_create( ui_Screen1)); }

         jsonRead(parameters, "diger", dig);
       
          
         jsonRead(parameters, "x", _x);
         jsonRead(parameters, "y", _y);
         jsonRead(parameters,  "id2show", _id2show);
        // jsonRead(parameters,  "id", _id);
         jsonRead(parameters, "width", _x1);
         jsonRead(parameters, "height", _y1);
         jsonRead(parameters, "color_of", color_of);
         jsonRead(parameters, "color_on", color_on);
         jsonRead(parameters, "color_border", color_border);
         jsonRead(parameters, "size_border", size_border);
         jsonRead(parameters, "Visibility", Visibility);
         jsonRead(parameters, "radius", radius);

         
        
        

         button_id.push_back(_id2show);
         button_value.push_back(_id);
    
    lv_obj_set_width(ui_Button[isf1], _x1);
    lv_obj_set_height(ui_Button[isf1], _y1);
    lv_obj_set_x(ui_Button[isf1], _x);
    lv_obj_set_y(ui_Button[isf1], _y);
    lv_obj_set_align(ui_Button[isf1], LV_ALIGN_DEFAULT);
    lv_obj_add_flag(ui_Button[isf1], LV_OBJ_FLAG_SCROLL_ON_FOCUS);     /// Flags
    lv_obj_remove_flag(ui_Button[isf1], LV_OBJ_FLAG_SCROLLABLE);      /// Flags
    lv_obj_set_style_bg_color(ui_Button[isf1], lv_color_hex(color_of), LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_color(ui_Button[isf1], lv_color_hex(color_on), LV_PART_MAIN | LV_STATE_CHECKED);
    lv_obj_set_style_bg_opa(ui_Button[isf1], Visibility, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_border_color(ui_Button[isf1], lv_color_hex(color_border), LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_border_opa(ui_Button[isf1], Visibility, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_border_width(ui_Button[isf1], size_border, LV_PART_MAIN | LV_STATE_DEFAULT);
 
    lv_obj_set_style_radius(ui_Button[isf1], radius, LV_PART_MAIN | LV_STATE_DEFAULT);  // 0 - _radius


     button_diger.push_back(dig);
        if (dig == 0){
        lv_obj_add_event_cb(ui_Button[isf1], ui_event_Button1, LV_EVENT_ALL, (void*)isf1);
        } else {
        lv_obj_add_event_cb(ui_Button[isf1], ui_event_Button, LV_EVENT_ALL, (void*)isf1);
        }


     lv_obj_add_event_cb(ui_Button[isf1], ui_event_Scrin, LV_EVENT_PRESSED, (void*)1); 
    isf11 = isf1;
    isf1 = isf1 + 1;   

    if (_id2show != _id) {
    IoTItem* trackingItem = findIoTItem(_id2show);
    if (trackingItem != nullptr) {
        _trackingValue = &(trackingItem->value);
        button_id[isf11] = " ";
    }
    }
}

  void onRegEvent(IoTItem* eventItem) override {
        if ((_trackingValue == nullptr) && eventItem && eventItem->getID() == _id2show) {
            _trackingValue = &(eventItem->value);
            button_id[isf11] = " ";
        }
        if (eventItem && eventItem->getID() == _id2show && !_generateOrderForTracking) {
            if (_valueSource != "web" && _valueSource != "mqtt") {
                _valueSource = "id2show";
            }
            Serial.printf("[onRegEvent] %s registered event, source: %s\n", eventItem->getID().c_str(), _valueSource.c_str());
        }
        if (eventItem && _id2show == eventItem->getID()) {
            setValue(eventItem->value, false);
        }
        IoTItem::onRegEvent(eventItem);
    }

    void onTrackingValue(IoTItem* item) override {
        if (!item || _id == _id2show) return;

        bool isOwnOrder = _generateOrderForTracking && (millis() - _lastOrderTime < 50);
        if (isOwnOrder) {
            Serial.printf("[%s] onTrackingValue: own order from %s\n", _valueSource.c_str(), item->getID().c_str());
        } else {
            if ((millis() - _lastExternalUpdateTime < 100) && _lastExternalUpdateSource != "") {
                _valueSource = _lastExternalUpdateSource;
                Serial.printf("[%s] onTrackingValue: external update from %s\n", _valueSource.c_str(), item->getID().c_str());
            } else {
                _valueSource = "id2show";
                Serial.printf("[id2show] onTrackingValue: external update from %s\n", item->getID().c_str());
            }
        }
        _generateOrderForTracking = false;
        _pendingMqttUpdate = false;
        _lastExternalUpdateSource = "";
        IoTItem::onTrackingValue(item);
    }

   String valrt = "";
  void drawItem(IoTItem *item) {
       String tmpStr = "";
        tmpStr += item->getValue();
        if (dig == 1){
            if (tmpStr == "0"){
                lv_obj_clear_state(ui_Button[isf11],LV_STATE_CHECKED);
            }
            else{
               lv_obj_add_state(ui_Button[isf11],LV_STATE_CHECKED);
            }

             if (_id2show != _id && valrt != String(value.valD) && (_valueSource == "web" || _valueSource == "mqtt")){
                _generateOrderForTracking = true;
                _lastOrderTime = millis();
                if ( _trackingValue == nullptr)  {
                    otpravkaidvalue( _id2show, String(value.valD)); 
                    valrt = String(value.valD);    
                }
                else { 
                    generateOrder( _id2show, String(value.valD)); 
                    valrt = String(value.valD); 
                }
             }
        }
    }

    void onModuleOrder(String& key, String& value) override {
        if (key == _id || key == _id2show) {
            _valueSource = "web";
            _pendingMqttUpdate = false;
            if (key == _id2show && !_generateOrderForTracking) {
                _lastExternalUpdateTime = millis();
                _lastExternalUpdateSource = "web";
            }
            Serial.printf("[web] ModuleOrder: %s = %s\n", key.c_str(), value.c_str());
        }
        IoTItem::onModuleOrder(key, value);
    }

     void setValue(const IoTValue& Value, bool genEvent = true) {
        value = Value;

        bool directOrder = isCurrentOrderForMe();
        if (_pendingMqttUpdate) {
            _valueSource = "mqtt";
            _pendingMqttUpdate = false;
        } else if (directOrder) {
            _valueSource = "web";
        }

        drawItem(this);
        regEvent((String)(int)value.valD, F("Panel_button"), false, genEvent);
    }

    String getValue() {
        return (String)(int)value.valD;
    }

    bool isCurrentOrderForMe() {
        if (orderBuf.length() == 0) return false;
        String currentOrder = selectToMarker(orderBuf, ",");
        if (currentOrder.length() == 0) return false;
        String currentKey = selectToMarker(currentOrder, " ");
        return currentKey == _id;
    }

    IoTValue execute(String command, std::vector<IoTValue> &param){

            if (command == "hide"){
                lv_obj_add_flag(ui_Button[isf1 - 1], LV_OBJ_FLAG_HIDDEN);
            };
           
            if (command == "show"){
                 lv_obj_clear_flag(ui_Button[isf1 - 1], LV_OBJ_FLAG_HIDDEN);
            };

             if (command == "color_on"){
             color_on = param[0].valD;
             lv_obj_set_style_bg_color(ui_Button[isf1 - 1], lv_color_hex(color_on), LV_PART_MAIN | LV_STATE_CHECKED);
            }

              if (command == "color_of"){
             color_of = param[0].valD;
              lv_obj_set_style_bg_color(ui_Button[isf1], lv_color_hex(color_of), LV_PART_MAIN | LV_STATE_DEFAULT);
            }

            if (command == "pos"){
                _x = param[0].valD;
                _y = param[1].valD;
                lv_obj_set_pos(ui_Button[isf1 - 1], _x, _y);
    
            }
        return {};

     }

    void onMqttRecive(String& topic, String& msg) override {
        _pendingMqttUpdate = true;
        IoTItem::onMqttRecive(topic, msg);
    }

 ~Panel_button(){ };
};



// обработка кнопки с экрана
void ui_event_Button(lv_event_t * e)
{
   int i = (int)lv_event_get_user_data(e);
  
    lv_event_code_t event_code = lv_event_get_code(e);

    if(event_code == LV_EVENT_CLICKED) {
       bool b = lv_obj_has_state(ui_Button[i],LV_STATE_CHECKED);
    
       if (b){
       
         generateOrder( button_value[i], String("0"));
       }
       else{
           generateOrder( button_value[i], String("1"));
       }  
    }
}


void ui_event_Button1(lv_event_t * e)
{
   int i = (int)lv_event_get_user_data(e);
  
    lv_event_code_t event_code = lv_event_get_code(e);

    if(event_code == LV_EVENT_PRESSED) {
      lv_obj_add_state(ui_Button[i],LV_STATE_CHECKED);  
    }

    if(event_code == LV_EVENT_RELEASED) {
      lv_obj_clear_state(ui_Button[i],LV_STATE_CHECKED); 
    }


    if(event_code == LV_EVENT_CLICKED) {
       
       bool b = lv_obj_has_state(ui_Button[i],LV_STATE_CHECKED);
    
       if (b){
       }
       else{
       
        generateOrder( button_value[i], "1"); 
        lv_obj_clear_state(ui_Button[i],LV_STATE_CHECKED);
         
       }  
    }
}



