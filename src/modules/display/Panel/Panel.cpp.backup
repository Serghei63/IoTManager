String valrt = "";
 void setValue(const IoTValue& Value, bool genEvent = true) {
        value = Value;

        bool directOrder = isCurrentOrderForMe();
        if (_pendingMqttUpdate) {
            _valueSource = "mqtt";
            _pendingMqttUpdate = false;
        } else if (directOrder) {
            _valueSource = "web";
        }

        lv_textarea_set_text(ui_TextArea[tex1], value.valS.c_str());
        if (_id2show != _id && valrt != String(value.valD) && (_valueSource == "web" || _valueSource == "mqtt")){
            _generateOrderForTracking = true;
            _lastOrderTime = millis();
            if ( _trackingValue == nullptr)  {
                otpravkaidvalue( _id2show, String(value.valD)); 
                valrt = String(value.valD);    
            }
            else { generateOrder( _id2show, String(value.valD)); 
                valrt = String(value.valD); 
             }
        }
 
        regEvent((String)value.valS, F("Panel_TextArea"), false, genEvent);
    }

    String getValue() {
        return (String)value.valS;
    }

    void onRegEvent(IoTItem* eventItem) override {
        if (!eventItem || _id2show == "") return;

        if ((_trackingValue == nullptr) && eventItem->getID() == _id2show) {
            _trackingValue = &(eventItem->value);
            TextArea_id2[tex1] = "";
        }
        if (eventItem && eventItem->getID() == _id2show && !_generateOrderForTracking) {
            if (_valueSource != "web" && _valueSource != "mqtt") {
                _valueSource = "id2show";
            }
            Serial.printf("[onRegEvent] %s registered event, source: %s\n", eventItem->getID().c_str(), _valueSource.c_str());
        }
        if (eventItem->getID() == _id2show) {
            setValue(eventItem->value, false);
        }

        IoTItem::onRegEvent(eventItem);
    }

    void onTrackingValue(IoTItem* eventItem) override {
        if (!eventItem || _id == _id2show) return;

        bool isOwnOrder = _generateOrderForTracking && (millis() - _lastOrderTime < 50);
        if (isOwnOrder) {
            Serial.printf("[%s] onTrackingValue: own order from %s\n", _valueSource.c_str(), eventItem->getID().c_str());
        } else {
            if ((millis() - _lastExternalUpdateTime < 100) && _lastExternalUpdateSource != "") {
                _valueSource = _lastExternalUpdateSource;
                Serial.printf("[%s] onTrackingValue: external update from %s\n", _valueSource.c_str(), eventItem->getID().c_str());
            } else {
                _valueSource = "id2show";
                Serial.printf("[id2show] onTrackingValue: external update from %s\n", eventItem->getID().c_str());
            }
        }
        _generateOrderForTracking = false;
        _pendingMqttUpdate = false;
        _lastExternalUpdateSource = "";
        IoTItem::onTrackingValue(eventItem); // updates our own value
    }

    void onModuleOrder(String& key, String& value) override {
        if (key == _id || key == _id2show) {
            _valueSource = "web";
            _pendingMqttUpdate = false;
            if (key == _id2show && !_generateOrderForTracking) {
                _lastExternalUpdateTime = millis();
                _lastExternalUpdateSource = "web";
            }
            Serial.printf("[web] ModuleOrder: %s = %s\n", key.c_str(), value.c_str());
        }
        IoTItem::onModuleOrder(key, value);
    }

    bool isCurrentOrderForMe() {
        if (orderBuf.length() == 0) return false;
        String currentOrder = selectToMarker(orderBuf, ",");
        if (currentOrder.length() == 0) return false;
        String currentKey = selectToMarker(currentOrder, " ");
        return currentKey == _id;
    }

     IoTValue execute(String command, std::vector<IoTValue> &param){

            if (command == "hide"){
                lv_obj_add_flag(ui_TextArea[tex - 1], LV_OBJ_FLAG_HIDDEN);
            };
           
            if (command == "show"){
                 lv_obj_clear_flag(ui_TextArea[tex - 1], LV_OBJ_FLAG_HIDDEN);
            };

             if (command == "color"){
             color = param[0].valD;
             lv_obj_set_style_bg_color(ui_TextArea[tex - 1], lv_color_hex(color), LV_PART_MAIN | LV_STATE_DEFAULT);
            }
            if (command == "pos"){
                _x = param[0].valD;
                _y = param[1].valD;
                lv_obj_set_pos(ui_TextArea[tex - 1], _x, _y);
    
            }
        return {};

     };
    

    void onMqttRecive(String& topic, String& msg) override {
        _pendingMqttUpdate = true;
        IoTItem::onMqttRecive(topic, msg);
    }

