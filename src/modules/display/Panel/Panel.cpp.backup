class Panel_bar : public IoTItem {

private:

int nomer = 1;
String  name = "";
int _x = 0, _y = 0, _x1 = 0, _y1 =0;
int _x2 = 0, _y2 = 100, _x3 = 120, _y3 = 60;
int color = 0x1A7D35;
int valy = 0;
String _id2show = "";
String _valueSource = "unknown";
bool _pendingMqttUpdate = false;
bool _generateOrderForTracking = false;
unsigned long _lastOrderTime = 0;
unsigned long _lastExternalUpdateTime = 0;
String _lastExternalUpdateSource = "";
int bar1 = 0;

public:
    Panel_bar(String parameters) : IoTItem(parameters) {

        
        jsonRead(parameters, "NAME", name);
        jsonRead(parameters, "Nomer", nomer);

        String rt56 = "";
        jsonRead(parameters, "id2show", _id2show);
        bar_id2.push_back(_id2show);
        bar_id.push_back(_id);
    
      
        if (name == "TabPage" && tab2 >= nomer ) 
        {
                ui_Bar.push_back( lv_bar_create( ui_TabPage[nomer - 1]));
        }
          else if (name == "Button" && isf1 >= nomer ) 
        {   
                ui_Bar.push_back( lv_bar_create( ui_Button[nomer - 1]));
        }
        else if (name == "Container" && cont >= nomer ) {
             
                ui_Bar.push_back( lv_bar_create( ui_Container[nomer - 1]));}
        else 
        {
                ui_Bar.push_back( lv_bar_create( ui_Screen1)); 
        } 
           

         jsonRead(parameters, "x", _x);
         jsonRead(parameters, "y", _y);
         jsonRead(parameters, "width", _x1);
         jsonRead(parameters, "height", _y1);
         jsonRead(parameters, "color", color);
         jsonRead(parameters, "range_sart", _x2);
         jsonRead(parameters, "range_end", _y2);
         
         
      
    lv_obj_set_width( ui_Bar[bar], _x1);
    lv_obj_set_height( ui_Bar[bar], _y1);
    lv_obj_set_x( ui_Bar[bar], _x);
    lv_obj_set_y( ui_Bar[bar], _y);
    lv_bar_set_range( ui_Bar[bar], _x2, _y2);
    lv_bar_set_value(ui_Bar[bar], value.valD , LV_ANIM_OFF);
    lv_bar_set_start_value(ui_Bar[bar], 40, LV_ANIM_OFF);

    lv_obj_set_style_bg_color(ui_Bar[bar], lv_color_hex(color), LV_PART_INDICATOR | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_opa(ui_Bar[bar], 255, LV_PART_INDICATOR | LV_STATE_DEFAULT);
        
     
        bar1 = bar;
        bar = bar + 1;

        if (_id2show != _id) {
        IoTItem* trackingItem = findIoTItem(_id2show);
        if (trackingItem != nullptr) {
            _trackingValue = &(trackingItem->value);
            bar_id2[bar1] = "";
        }
    }
}

void onRegEvent(IoTItem* eventItem) override {
        if ((_trackingValue == nullptr) && eventItem && eventItem->getID() == _id2show) {
            _trackingValue = &(eventItem->value);
            bar_id2[bar1] = "";
        }
        if (eventItem && eventItem->getID() == _id2show && !_generateOrderForTracking) {
            if (_valueSource != "web" && _valueSource != "mqtt") {
                _valueSource = "id2show";
            }
            Serial.printf("[onRegEvent] %s registered event, source: %s\n", eventItem->getID().c_str(), _valueSource.c_str());
        }
        if (eventItem && _id2show == eventItem->getID()) {
            setValue(eventItem->value, false);
        }
        IoTItem::onRegEvent(eventItem);
    }

    void onTrackingValue(IoTItem* item) override {
        if (!item || _id == _id2show) return;

        bool isOwnOrder = _generateOrderForTracking && (millis() - _lastOrderTime < 50);
        if (isOwnOrder) {
            Serial.printf("[%s] onTrackingValue: own order from %s\n", _valueSource.c_str(), item->getID().c_str());
        } else {
            if ((millis() - _lastExternalUpdateTime < 100) && _lastExternalUpdateSource != "") {
                _valueSource = _lastExternalUpdateSource;
                Serial.printf("[%s] onTrackingValue: external update from %s\n", _valueSource.c_str(), item->getID().c_str());
            } else {
                _valueSource = "id2show";
                Serial.printf("[id2show] onTrackingValue: external update from %s\n", item->getID().c_str());
            }
        }
        _generateOrderForTracking = false;
        _pendingMqttUpdate = false;
        _lastExternalUpdateSource = "";
        IoTItem::onTrackingValue(item);
    }

    String valrt = "";
void drawItem(IoTItem *item) {
   
              lv_bar_set_value(ui_Bar[bar1], value.valD , LV_ANIM_OFF);
            
             if (_id2show != _id && valrt != String(value.valD) && (_valueSource == "web" || _valueSource == "mqtt")){
                _generateOrderForTracking = true;
                _lastOrderTime = millis();
                if ( _trackingValue == nullptr)  {
                otpravkaidvalue( _id2show, String(value.valD)); 
                valrt = String(value.valD);    
            }
            else { generateOrder( _id2show, String(value.valD)); 
                valrt = String(value.valD); 
             }
        } 
    }


  void setValue(const IoTValue& Value, bool genEvent = true) {
        value = Value;

        bool directOrder = isCurrentOrderForMe();
        if (_pendingMqttUpdate) {
            _valueSource = "mqtt";
            _pendingMqttUpdate = false;
        } else if (directOrder) {
            _valueSource = "web";
        }

        drawItem(this);
        regEvent((String)(int)value.valD, F("Panel_bar"), false, genEvent);
    }

    String getValue() {
        return (String)(int)value.valD;
    }

    void onModuleOrder(String& key, String& value) override {
        if (key == _id || key == _id2show) {
            _valueSource = "web";
            _pendingMqttUpdate = false;
            if (key == _id2show && !_generateOrderForTracking) {
                _lastExternalUpdateTime = millis();
                _lastExternalUpdateSource = "web";
            }
            Serial.printf("[web] ModuleOrder: %s = %s\n", key.c_str(), value.c_str());
        }
        IoTItem::onModuleOrder(key, value);
    }

    bool isCurrentOrderForMe() {
        if (orderBuf.length() == 0) return false;
        String currentOrder = selectToMarker(orderBuf, ",");
        if (currentOrder.length() == 0) return false;
        String currentKey = selectToMarker(currentOrder, " ");
        return currentKey == _id;
    }

   
    IoTValue execute(String command, std::vector<IoTValue> &param){

            if (command == "hide"){
                lv_obj_add_flag(ui_Bar[bar - 1], LV_OBJ_FLAG_HIDDEN);
            };
           
            if (command == "show"){
                 lv_obj_clear_flag(ui_Bar[bar - 1], LV_OBJ_FLAG_HIDDEN);
            };

             if (command == "color"){
             color = param[0].valD;
             lv_obj_set_style_arc_color(ui_Bar[bar - 1], lv_color_hex(color), LV_PART_INDICATOR | LV_STATE_DEFAULT);
            }
            if (command == "pos"){
                _x = param[0].valD;
                _y = param[1].valD;
                lv_obj_set_pos(ui_Bar[bar - 1], _x, _y);
    
            }
        return {};

     };



    void onMqttRecive(String& topic, String& msg) override {
        _pendingMqttUpdate = true;
        IoTItem::onMqttRecive(topic, msg);
    }

 ~Panel_bar(){};
};




