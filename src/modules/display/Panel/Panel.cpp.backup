int _x2 = 0, _y2 = 100, _x3 = 120, _y3 = 60;
int color = 0x1A7D35;
int valy = 0;

public:
    Panel_img(String parameters) : IoTItem(parameters) {

        
        jsonRead(parameters, "NAME", name);
        jsonRead(parameters, "Nomer", nomer);

        
    
      
        if (name == "TabPage" && tab2 >= nomer ) 
        {
                ui_Image.push_back( lv_image_create( ui_TabPage[nomer - 1]));
        }
          else if (name == "Button" && isf1 >= nomer ) 
        {   
                ui_Image.push_back( lv_image_create( ui_Button[nomer - 1]));
        }
        else if (name == "Container" && cont >= nomer ) {
             
                ui_Image.push_back( lv_image_create( ui_Container[nomer - 1]));}
        else 
        {
                ui_Image.push_back( lv_image_create( ui_Screen1)); 
        } 
           

         jsonRead(parameters, "x", _x);
         jsonRead(parameters, "y", _y);
         jsonRead(parameters, "width", _x1);
         jsonRead(parameters, "height", _y1);
         jsonRead(parameters, "color", color);
         String file = "";
        String name_img = "";
         jsonRead(parameters, "file", file);
         jsonRead(parameters, "name_img", name_img);
         
        
    lv_obj_set_width(ui_Image[img], LV_SIZE_CONTENT);   /// 1
    lv_obj_set_height(ui_Image[img], LV_SIZE_CONTENT);    /// 1
    lv_obj_add_flag(ui_Image[img], LV_OBJ_FLAG_CLICKABLE);     /// Flags
    lv_obj_remove_flag(ui_Image[img], LV_OBJ_FLAG_SCROLLABLE);     
         
      
    
    lv_obj_set_x( ui_Image[img], _x);
    lv_obj_set_y( ui_Image[img], _y);



  
     // LV_IMG_DECLARE(solnce);

   // LV_IMG_DECLARE(oblo);


   // if (name_img == "solnce")
   //    lv_img_set_src(ui_Image[img], &solnce);

   // else if (name_img == "oblo")
   //    lv_img_set_src(ui_Image[img], &oblo);

        img = img + 1;
}





  void setValue(const IoTValue& Value, bool genEvent = true) {
        value = Value;
        regEvent((String)(int)value.valD, F("Panel_img"), false, genEvent);
    }

    String getValue() {
        return (String)(int)value.valD;
    }

   
    IoTValue execute(String command, std::vector<IoTValue> &param){

            if (command == "hide"){
                lv_obj_add_flag(ui_Image[img - 1], LV_OBJ_FLAG_HIDDEN);
            };
           
            if (command == "show"){
                 lv_obj_clear_flag(ui_Image[img - 1], LV_OBJ_FLAG_HIDDEN);
            };

             if (command == "color"){
             color = param[0].valD;
             lv_obj_set_style_img_recolor(ui_Image[img - 1], lv_color_hex(color), LV_PART_MAIN | LV_STATE_DEFAULT);
            }
            if (command == "pos"){
                _x = param[0].valD;
                _y = param[1].valD;
                lv_obj_set_pos(ui_Image[img - 1], _x, _y);
    
            }
        return {};

     };



    void onMqttRecive(String& topic, String& msg) override {
        // Panel_img may not need MQTT handling, but adding for consistency
        IoTItem::onMqttRecive(topic, msg);
    }

 ~Panel_img(){};
};


void spi_init() {
    SPI.begin(48, 41, 47); // SCK, MISO, MOSI
    SPI.setFrequency(40000000); // 40 MHz
    SPI.setDataMode(SPI_MODE0);
    SPI.setBitOrder(MSBFIRST);
}

void sd_init() {
    if (!SD.begin(42, SPI, 40000000, "/B")) {
        SerialPrint("e", F("SD"), "Failed to initialize SD card");
        return;
    }
    SerialPrint("i", F("SD"), "SD card initialized successfully");
}




//////////////////////////////////////////////////////
    //      ФУНКЦИИ          
//////////////////////////////////////////////////////

void otpravkaidvalue(String id1, String zn){

    
         if (mqttIsConnect() == 1){

            String json = "{}";
             String json1 = "{}";
            jsonWriteStr_(json, "id",id1);
            jsonWriteStr_(json, "val", zn);
            jsonWriteInt_(json, "int", 0);
            Serial.println("///////" +id1 + " " + zn);
            SerialPrint("i", F("=>MQTT"), "Generate event: " + json);
         if ( json != json1) {
            publishEvent(id1,json);
            publishStatusMqtt(id1,zn);
            generateOrder(id1, zn );
            json1 = json;
         }
        }
}
         


