//текст

class Panel_label : public IoTItem {

private:

int nomer = 1;
String  name = "";
int _x = 0, _y = 0,  shr = 40;
int color = 0x1A7D35;
lv_font_t shrit = serg20;
String _id2show = "";
String descr ="";
String descr1 ="";
int nb1 = 0;
int _round = 0;
String _valueSource = "unknown"; // web, mqtt, id2show
bool _pendingMqttUpdate = false;
bool _generateOrderForTracking = false;  // флаг: Label сам вызвал generateOrder для _id2show
unsigned long _lastOrderTime = 0;  // время последнего generateOrder
unsigned long _lastExternalUpdateTime = 0;  // время последнего внешнего обновления
String _lastExternalUpdateSource = "";  // источник последнего внешнего обновления

public:
    Panel_label(String parameters) : IoTItem(parameters) {

        
        jsonRead(parameters, "NAME", name);
        jsonRead(parameters, "Nomer", nomer);

      
        if (name == "TabPage" && tab2 >= nomer ) 
        {
                ui_Label.push_back( lv_label_create( ui_TabPage[nomer - 1]));
        }
        else if (name == "Button" && isf1 >= nomer ) 
        {   
                ui_Label.push_back( lv_label_create( ui_Button[nomer - 1]));
        }
        else if (name == "Container" && cont >= nomer ) {
             
                ui_Label.push_back( lv_label_create( ui_Container[nomer - 1]));}
        else 
        {
                ui_Label.push_back( lv_label_create( ui_Screen1)); 
        } 
        
        
       


         jsonRead(parameters, "x", _x);
         jsonRead(parameters, "y", _y);
         jsonRead(parameters, "id2show", _id2show );
         jsonRead(parameters, "color", color);
         jsonRead(parameters, "shrift", shr);
        jsonRead(parameters, "descr1", descr);
        jsonRead(parameters, "descr2", descr1);


      
         label_id.push_back(_id);
         label_id2.push_back(_id2show);
         label_descr.push_back(descr);
         label_descr1.push_back(descr1);
         String valy1 = label_descr[nb] + " " + value.valS + " "+ label_descr1[nb];


        lv_obj_set_width(ui_Label[nb], LV_SIZE_CONTENT);   /// 1
        lv_obj_set_height(ui_Label[nb], LV_SIZE_CONTENT);    /// 1
        lv_obj_set_x(ui_Label[nb], _x);
        lv_obj_set_y(ui_Label[nb], _y);
        lv_obj_set_align(ui_Label[nb], LV_ALIGN_DEFAULT);
        
        

        lv_obj_add_flag(ui_Label[nb], LV_OBJ_FLAG_SCROLL_ON_FOCUS);     /// Flags
        lv_obj_remove_flag(ui_Label[nb], LV_OBJ_FLAG_SCROLLABLE); 
         if (shr == 43) {}
         else
        {lv_obj_set_style_text_color(ui_Label[nb], lv_color_hex(color), LV_PART_MAIN | LV_STATE_DEFAULT);}
        lv_obj_set_style_text_opa(ui_Label[nb], 255, LV_PART_MAIN | LV_STATE_DEFAULT);
        lv_label_set_text(ui_Label[nb], valy1.c_str());


        conshrift( shrit , shr );
      
        lv_obj_set_style_text_font(ui_Label[nb], &shrit, LV_PART_MAIN | LV_STATE_DEFAULT);

        lv_obj_add_event_cb(ui_Label[nb], ui_event_Scrin, LV_EVENT_PRESSED, (void*)1);
        nb1 = nb;
        nb = nb + 1;

        

         if (_id2show != _id) {
        IoTItem* trackingItem = findIoTItem(_id2show);
         if (trackingItem != nullptr) {
             _trackingValue = &(trackingItem->value);
             label_id2[nb1] = " ";
         }
        }

        jsonReadStr(parameters, "round", _round);

}

     String valrtS = "";
     float _valrtD = 0;
     
     //int  d = 0;
     void drawItem(IoTItem *item) {
        String tmpStr = descr;
        tmpStr += " ";
        tmpStr += value.valS;
        tmpStr += " ";
        tmpStr += descr1;
         const char*  _text = tmpStr.c_str();   
        lv_label_set_text(ui_Label[nb1], _text);

      Serial.println("[" + _valueSource + "] Draw: " + _id + " = " + String(value.valD));
           if ( _trackingValue == nullptr &&  _valueSource == "web" ) {  
           
        _generateOrderForTracking = true;  // Отмечаем, что мы сами генерируем order
        _lastOrderTime = millis();
        otpravkaidvalue( _id2show, value.valS);
        Serial.println("[" + _valueSource + "] Send to " + _id2show + ": " + value.valS);
    
           }
           else {
               String currentValue = value.valD ? String(value.valD) : value.valS;
               if (getItemValue(_id2show) != currentValue && (_valueSource == "mqtt" || _valueSource == "web")) {
                   _generateOrderForTracking = true;  // Отмечаем, что мы сами генерируем order
                   _lastOrderTime = millis();
                   generateOrder(_id2show, currentValue);
                   Serial.println("[" + _valueSource + "] Order to " + _id2show + ": " + currentValue);
               }
           }
    }
  
   void onMqttRecive(String& topic, String& msg) override {
       if (topic.indexOf(F("control")) != -1) {
           String key = selectFromMarkerToMarker(topic, "/", 3);
           if (key == _id || key == _id2show) {
              _pendingMqttUpdate = true;
              if (key == _id2show && !_generateOrderForTracking) {
                  _lastExternalUpdateTime = millis();
                  _lastExternalUpdateSource = "mqtt";
              }
              Serial.printf("[mqtt] Control: %s = %s\n", key.c_str(), msg.c_str());
            }
        } else if (topic.indexOf(F("status")) != -1){
            String key = selectFromMarkerToMarker(topic, "/", 3);
            if (key == _id2show &&  _trackingValue == nullptr && _pendingMqttUpdate != true) {
                
             String valueIfJson = "";  // проверяем формат, если json то берем статус, иначе - как есть
        if (!jsonRead(msg, F("status"), valueIfJson, false))
          { 
            _pendingMqttUpdate = true;
            _lastExternalUpdateTime = millis();
            _lastExternalUpdateSource = "mqtt";
            Serial.printf("[mqtt-status] %s = %s (raw)\n", key.c_str(), msg.c_str());
            generateOrder(_id, msg);
          }
        else    {  
            if (value.valD == valueIfJson.toFloat() || value.valS == valueIfJson){} 
            else{
                _pendingMqttUpdate = true;
                _lastExternalUpdateTime = millis();
                _lastExternalUpdateSource = "mqtt";
           generateOrder(_id, valueIfJson);
           Serial.printf("[mqtt-status] %s = %s (parsed)\n", key.c_str(), valueIfJson.c_str());
           }
        }
            
           }
        IoTItem::onMqttRecive(topic, msg);
   }
}

  void onModuleOrder(String& key, String& value) override {
        if (key == _id || key == _id2show) {
            _valueSource = "web";
            _pendingMqttUpdate = false;
            if (key == _id2show && !_generateOrderForTracking) {
                _lastExternalUpdateTime = millis();
                _lastExternalUpdateSource = "web";
            }
            Serial.printf("[web] ModuleOrder: %s = %s\n", key.c_str(), value.c_str());
        }
       IoTItem::onModuleOrder(key, value);
  }

  void setValue(const IoTValue& Value, bool genEvent = true) {
        value = Value;
        
        // Определяем источник значения
        bool directOrder = isCurrentOrderForMe();
        if (_pendingMqttUpdate) {
            _valueSource = "mqtt";
            _pendingMqttUpdate = false;
        } else if (directOrder) {
            _valueSource = "web";
        } else if (_valueSource == "unknown") {
            _valueSource = "web";
        }
    
        if (value.valD ) {
            if(_id != _id2show && _valrtD != value.valD ){
                 Serial.printf("[%s] setValue: %s = %.2f\n", _valueSource.c_str(), _id.c_str(), value.valD);
               drawItem(this);
                _valrtD = value.valD;
                valrtS = String(value.valD);
                    IoTItem::setValue(Value, genEvent);
                regEvent((String)(float)value.valD, F("Panel_label"), false, genEvent);
            }
        }

        if (value.valS ) {
            if(_id != _id2show && valrtS != value.valS  ){
                Serial.printf("[%s] setValue: %s = %s\n", _valueSource.c_str(), _id.c_str(), value.valS.c_str());
                drawItem(this);
                valrtS = value.valS;
                IoTItem::setValue(Value, genEvent);
                regEvent((String)value.valS, F("Panel_label"), false, genEvent);
            }
        }
     
    }

    String getValue() {
        if (value.valD ) { 
                return (String)(float)value.valD; 
        } 
       else {
              return (String)value.valS;
        };
      
   }

   String getValueSource() {
        return _valueSource;
   }

   bool isCurrentOrderForMe() {
        if (orderBuf.length() == 0) return false;
        String currentOrder = selectToMarker(orderBuf, ",");
        if (currentOrder.length() == 0) return false;
        String currentKey = selectToMarker(currentOrder, " ");
        return currentKey == _id;
   }

   void onRegEvent(IoTItem* eventItem) override {
        if ((_trackingValue == nullptr) && eventItem && eventItem->getID() == _id2show) {
            _trackingValue = &(eventItem->value);
            label_id2[nb1] = " ";
        }
        
        // Отслеживаем события в _id2show для определения источника
        if (eventItem && eventItem->getID() == _id2show && !_generateOrderForTracking) {
            if (_valueSource != "web" && _valueSource != "mqtt") {
                _valueSource = "id2show";  // Внешнее обновление
            }
            Serial.printf("[onRegEvent] %s registered event, source: %s\n", eventItem->getID().c_str(), _valueSource.c_str());
        }
        
        IoTItem::onRegEvent(eventItem);
    }

void onTrackingValue(IoTItem* item) override {
        if (item == nullptr || _id == _id2show) return;
        
        // Проверяем, вызвал ли это сам Label через generateOrder
        bool isOwnOrder = _generateOrderForTracking && (millis() - _lastOrderTime < 50);  // 50ms временное окно
        
        if (isOwnOrder) {
            // Это был наш Order - сохраняем текущий источник
            Serial.printf("[%s] onTrackingValue: own order from Label\n", _valueSource.c_str());
        } else {
            if ((millis() - _lastExternalUpdateTime < 100) && _lastExternalUpdateSource != "") {
                // Это внешнее обновление в течение 100ms и мы знаем его источник 
                _valueSource = _lastExternalUpdateSource;
                Serial.printf("[%s] onTrackingValue: external update from %s (%.0lf ms ago)\n", _valueSource.c_str(), item->getID().c_str(), (float)(millis() - _lastExternalUpdateTime));
            } else {
                // Это внешнее обновление, но мы не знаем источник
                _valueSource = "id2show";
                Serial.printf("[id2show] onTrackingValue: external update from %s\n", item->getID().c_str());
            }
        }
        
        _generateOrderForTracking = false;  // Очищаем флаг
        _pendingMqttUpdate = false;
        _lastExternalUpdateSource = "";  // Очищаем источник
        IoTItem::onTrackingValue(item); // updates own value from tracked item
    }



        IoTValue execute(String command, std::vector<IoTValue> &param){

            if (command == "hide"){
                lv_obj_add_flag(ui_Label[nb - 1], LV_OBJ_FLAG_HIDDEN);
            };
           
            if (command == "show"){
                 lv_obj_clear_flag(ui_Label[nb - 1], LV_OBJ_FLAG_HIDDEN);
            };

             if (command == "color"){
             color = param[0].valD;
             lv_obj_set_style_text_color(ui_Label[nb], lv_color_hex(color), LV_PART_MAIN | LV_STATE_DEFAULT);
            }
            if (command == "pos"){
                _x = param[0].valD;
                _y = param[1].valD;
                lv_obj_set_pos(ui_Label[nb - 1], _x, _y);
    
            }
        return {};

     }
    

 ~Panel_label(){};
};



